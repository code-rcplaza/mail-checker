{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(go test *)",
      "Bash(go build *)",
      "Bash(go vet *)",
      "Bash(gofmt *)",
      "Bash(pnpm *)",
      "Bash(sqlc generate *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(git push origin main *)",
      "Bash(git push * main)",
      "Bash(git push * main:*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force *)",
      "Bash(git push * -f *)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; case \"$f\" in *.go) gofmt -w \"$f\";; esac; } 2>/dev/null || true",
            "statusMessage": "gofmt"
          },
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; case \"$f\" in *.ts|*.tsx) b=\"$CLAUDE_PROJECT_DIR/frontend/node_modules/.bin/biome\"; [ -x \"$b\" ] && cd \"$CLAUDE_PROJECT_DIR/frontend\" && \"$b\" format --write \"$f\";; esac; } 2>/dev/null || true",
            "statusMessage": "biome format"
          }
        ]
      }
    ]
  }
}
